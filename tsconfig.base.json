{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "expo/tsconfig.base.json",
    "compilerOptions": {
        "isolatedModules": true,
        "strict": true,
        // Every project under the root solution is type-check only. `expo/tsconfig.base` happens to
        // set this too, but it is restated here because `tsc --build` rejects `--noEmit` as a command
        // line flag: the whole typecheck gate now depends on this option coming from a config file.
        "noEmit": true,
        "incremental": true,
        // React Native 0.88 serves its Strict TypeScript API (`types_generated/`) by default. Opt out until the app is
        // migrated to it: this condition resolves the legacy types (`types_DEPRECATED/`) and the `react-native/Libraries/*`
        // deep imports. `customConditions` replaces the array inherited from `expo/tsconfig.base`, so "react-native" is restated.
        "customConditions": ["react-native-legacy-deep-imports", "react-native"],
        "paths": {
            "@assets/*": ["./assets/*"],
            "@components/*": ["./src/components/*"],
            "@github/*": ["./.github/*"],
            "@hooks/*": ["./src/hooks/*"],
            "@libs/*": ["./src/libs/*"],
            "@navigation/*": ["./src/libs/Navigation/*"],
            "@pages/*": ["./src/pages/*"],
            "@prompts/*": ["./prompts/*"],
            "@scripts/*": ["./scripts/*", "./.github/scripts/*"],
            "@server/*": ["./server/*"],
            "@styles/*": ["./src/styles/*"],
            "@src/*": ["./src/*"],
            "@userActions/*": ["./src/libs/actions/*"],
            "@selectors/*": ["./src/selectors/*"],
            "tests/*": ["./tests/*"]
        }
    }
}
