{
    // Mirrors config/eslint/eslint.config.mjs rule for rule. Every `"off"` in this file carries a
    // comment saying which of three things it means, because "no findings today" is never the
    // reason a rule is off here:
    //   OFF, shadowed not dropped -- ESLint's own rule runs instead under a jsPlugin alias
    //                               (core/, hosted/) because oxlint's native port diverges.
    //   OFF, mirrors ESLint       -- ESLint has it off in the same scope; parity, not a gap.
    //   OFF, coverage gap         -- we want the rule, something specific blocks it. The reason is
    //                               on the line, and machine-readable in oxlint-migration/ruleMap.py
    //                               (PORT_PLAN); `npm run oxlint-rule-availability` prints them.
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["typescript", "import", "jsx-a11y", "unicorn", "react"],
    // Aliases are declared here (oxlint's {name, specifier} form) rather than inferred from each
    // plugin's meta.name: the alias is the prefix every suppression comment and comparison script
    // has to use, so it belongs where a reader looks for it. The invented names are unavoidable --
    // `react`, `import`, `jsdoc` are reserved for oxlint's native ports, and `core` cannot match
    // ESLint's bare core ids (`no-restricted-syntax`) because a jsPlugin rule always has a prefix.
    // Per-override jsPlugins stay bare package specifiers: their meta.name already matches the
    // prefix ESLint uses, so declaring it would only add noise.
    "jsPlugins": [
        {"name": "rulesdir", "specifier": "./config/oxlint/plugins/expensify-rules.mjs"},
        {"name": "report-name-utils", "specifier": "./config/eslint/plugins/eslint-plugin-report-name-utils.mjs"},
        {"name": "core", "specifier": "./config/oxlint/plugins/core-rules.mjs"},
        {"name": "hosted", "specifier": "./config/oxlint/plugins/hosted-rules.mjs"},
        {"name": "rc", "specifier": "./config/oxlint/plugins/rc-rules.mjs"}
    ],
    "categories": {
        "correctness": "off"
    },
    "options": {
        "typeAware": true
    },
    // The 1058-entry globals list the migrator generated is gone (2026-08-11). Every name in it
    // resolves through these env presets instead, and the presets track upstream rather than
    // freezing a snapshot. Verified, not assumed: a generated file referencing all 1058 names
    // produces zero `no-undef` findings, assigning to all 124 the list marked "writable"
    // produces zero `no-global-assign` findings, and the union of the `globals` package presets
    // used here contains nothing ESLint does not also define (which would silence a real
    // no-undef). browser + audioworklet replace the bulk; jest mirrors the globals.jest block
    // eslint.config.mjs applies to every file.
    "env": {
        "builtin": true,
        "es2026": true,
        "node": true,
        "browser": true,
        "audioworklet": true,
        "jest": true
    },
    // The one global no preset carries: eslint.config.mjs declares it next to globals.jest.
    "globals": {
        "__DEV__": "readonly"
    },
    "settings": {
        "react": {
            "version": "19.2.3"
        },
        "propWrapperFunctions": ["forbidExtraProps", "exact", "Object.freeze"],
        "progress": {
            "hide": false
        }
        // No `seatbelt` block, deliberately. eslint.config.mjs sets settings.seatbelt.seatbeltFile
        // with path.join(dirname, ...), which JSON cannot express, and nothing on this side reads it:
        // eslint-seatbelt suppresses through an ESLint processor, which oxlint has no concept of, so
        // `eslint-seatbelt/configure` is off here (obstacle #1 in ruleMap.py's PORT_PLAN). The block
        // this replaces carried an absolute path from one developer's checkout, so it resolved
        // nowhere else; verified dead, the full-repo report is identical without it. A `seatbelt`
        // block belongs here again only once something on this side reads the baseline.
    },
    "ignorePatterns": [
        "!**/.storybook",
        "!**/.github",
        ".github/actions/**/index.js",
        "**/*.config.js",
        "**/*.config.mjs",
        "**/node_modules/**/*",
        "**/dist/**/*",
        "server/**/dist/**",
        "server/victory-chart-renderer/.dev/**",
        ".eslint-reports/**/*",
        "android/**/build/**/*",
        "docs/vendor/**/*",
        "docs/assets/**/*",
        "web/gtm.js",
        "**/.expo/**/*",
        "**/.rock/**/*",
        "**/.yalc/**/*",
        "src/libs/SearchParser/searchParser.js",
        "src/libs/SearchParser/autocompleteParser.js",
        "help/_scripts/**/*",
        "modules/ExpensifyNitroUtils/nitrogen/**/*",
        "Mobile-Expensify/**/*",
        "**/vendor",
        "modules/group-ib-fp/**/*",
        "web/snippets/gib.js",
        "src/languages/de.ts",
        "src/languages/el.ts",
        "src/languages/es.ts",
        "src/languages/fr.ts",
        "src/languages/it.ts",
        "src/languages/ja.ts",
        "src/languages/nl.ts",
        "src/languages/pl.ts",
        "src/languages/pt-BR.ts",
        "src/languages/zh-hans.ts",
        "oxlint-migration/**"
    ],
    "rules": {
        "array-callback-return": [
            "error",
            {
                "allowImplicit": true
            }
        ],
        "block-scoped-var": "error",
        "curly": ["error", "all"],
        "default-case": [
            "error",
            {
                "commentPattern": "^no default$"
            }
        ],
        "default-case-last": "error",
        "default-param-last": "error",
        "eqeqeq": [
            "error",
            "always",
            {
                "null": "ignore"
            }
        ],
        "grouped-accessor-pairs": "error",
        "guard-for-in": "error",
        "max-classes-per-file": ["error", 1],
        "no-caller": "error",
        "no-case-declarations": "error",
        "no-constructor-return": "error",
        "no-else-return": [
            "error",
            {
                "allowElseIf": false
            }
        ],
        "no-empty-function": [
            "error",
            {
                "allow": ["arrowFunctions", "functions", "methods"]
            }
        ],
        "no-empty-pattern": "error",
        "no-eval": "error",
        "no-extend-native": "error",
        "no-extra-bind": "error",
        "no-extra-label": "error",
        "no-fallthrough": "error",
        "no-global-assign": [
            "error",
            {
                "exceptions": []
            }
        ],
        "no-implied-eval": "error",
        "no-iterator": "error",
        "no-labels": [
            "error",
            {
                "allowLoop": false,
                "allowSwitch": false
            }
        ],
        "no-lone-blocks": "error",
        "no-loop-func": "error",
        "no-multi-str": "error",
        "no-new": "error",
        "no-new-func": "error",
        "no-new-wrappers": "error",
        "no-nonoctal-decimal-escape": "error",
        "no-param-reassign": [
            "error",
            {
                "props": true,
                "ignorePropertyModificationsFor": ["acc", "accumulator", "e", "ctx", "context", "req", "request", "res", "response", "$scope", "staticContext"]
            }
        ],
        "no-proto": "error",
        "no-restricted-properties": [
            "error",
            {
                "object": "arguments",
                "property": "callee",
                "message": "arguments.callee is deprecated"
            },
            {
                "object": "global",
                "property": "isFinite",
                "message": "Please use Number.isFinite instead"
            },
            {
                "object": "self",
                "property": "isFinite",
                "message": "Please use Number.isFinite instead"
            },
            {
                "object": "window",
                "property": "isFinite",
                "message": "Please use Number.isFinite instead"
            },
            {
                "object": "global",
                "property": "isNaN",
                "message": "Please use Number.isNaN instead"
            },
            {
                "object": "self",
                "property": "isNaN",
                "message": "Please use Number.isNaN instead"
            },
            {
                "object": "window",
                "property": "isNaN",
                "message": "Please use Number.isNaN instead"
            },
            {
                "property": "__defineGetter__",
                "message": "Please use Object.defineProperty instead."
            },
            {
                "property": "__defineSetter__",
                "message": "Please use Object.defineProperty instead."
            },
            {
                "object": "Math",
                "property": "pow",
                "message": "Use the exponentiation operator (**) instead."
            }
        ],
        "no-script-url": "error",
        "no-self-assign": [
            "error",
            {
                "props": true
            }
        ],
        "no-self-compare": "error",
        "no-sequences": "error",
        "no-throw-literal": "error",
        "no-unused-expressions": [
            "error",
            {
                "allowShortCircuit": false,
                "allowTernary": false,
                "allowTaggedTemplates": false
            }
        ],
        "no-unused-labels": "error",
        "no-useless-catch": "error",
        "no-useless-concat": "error",
        "no-useless-escape": "error",
        "no-useless-return": "error",
        "no-void": "error",
        "no-with": "error",
        "prefer-promise-reject-errors": [
            "error",
            {
                "allowEmptyReject": true
            }
        ],
        "prefer-regex-literals": [
            "error",
            {
                "disallowRedundantWrapping": true
            }
        ],
        "radix": "error",
        "yoda": "error",
        "for-direction": "error",
        "getter-return": [
            "error",
            {
                "allowImplicit": true
            }
        ],
        "no-async-promise-executor": "error",
        "no-await-in-loop": "error",
        "no-compare-neg-zero": "error",
        "no-cond-assign": ["error", "always"],
        "no-console": [
            "error",
            {
                "allow": ["debug", "error"]
            }
        ],
        "no-constant-condition": "error",
        "no-control-regex": "error",
        "no-debugger": "error",
        "no-dupe-else-if": "error",
        "no-dupe-keys": "error",
        "no-duplicate-case": "error",
        "no-empty": "error",
        "no-empty-character-class": "error",
        "no-ex-assign": "error",
        "no-extra-boolean-cast": "error",
        "no-func-assign": "error",
        "no-import-assign": "error",
        "no-inner-declarations": "error",
        "no-invalid-regexp": "error",
        "no-irregular-whitespace": "error",
        "no-loss-of-precision": "error",
        "no-misleading-character-class": "error",
        "no-obj-calls": "error",
        "no-promise-executor-return": "error",
        "no-prototype-builtins": "error",
        "no-regex-spaces": "error",
        "no-setter-return": "error",
        "no-sparse-arrays": "error",
        "no-template-curly-in-string": "error",
        "no-unexpected-multiline": "error",
        "no-unreachable": "error",
        "no-unsafe-finally": "error",
        "no-unsafe-negation": "error",
        "no-unsafe-optional-chaining": [
            "error",
            {
                "disallowArithmeticOperators": true
            }
        ],
        "no-useless-backreference": "error",
        "use-isnan": "error",
        "valid-typeof": [
            "error",
            {
                "requireStringLiterals": true
            }
        ],
        "arrow-body-style": [
            "error",
            "as-needed",
            {
                "requireReturnForObjectLiteral": false
            }
        ],
        "constructor-super": "error",
        "no-class-assign": "error",
        "no-const-assign": "error",
        "no-dupe-class-members": "error",
        "no-restricted-imports": [
            "error",
            {
                "paths": [
                    {
                        "name": "react-native",
                        "importNames": ["Button", "Text", "TextInput", "Picker"],
                        "message": "Please use an Expensify component from src/components/ instead."
                    },
                    {
                        "name": "react-native",
                        "importNames": ["SafeAreaView"],
                        "message": "Please use SafeAreaView from react-native-safe-area-context"
                    }
                ]
            }
        ],
        "no-this-before-super": "error",
        "no-useless-computed-key": "error",
        "no-useless-constructor": "error",
        "no-useless-rename": [
            "error",
            {
                "ignoreDestructuring": false,
                "ignoreImport": false,
                "ignoreExport": false
            }
        ],
        "no-var": "error",
        "object-shorthand": [
            "error",
            "always",
            {
                "ignoreConstructors": false,
                "avoidQuotes": true
            }
        ],
        "prefer-arrow-callback": [
            "error",
            {
                "allowNamedFunctions": false,
                "allowUnboundThis": true
            }
        ],
        "prefer-const": [
            "error",
            {
                "destructuring": "any",
                "ignoreReadBeforeAssign": true
            }
        ],
        "prefer-numeric-literals": "error",
        "prefer-rest-params": "error",
        "prefer-spread": "error",
        "prefer-template": "error",
        "require-yield": "error",
        "symbol-description": "error",
        "import/no-named-as-default": "error",
        "import/no-named-as-default-member": "error",
        "import/no-mutable-exports": "error",
        "import/no-amd": "error",
        "import/first": "error",
        "import/no-duplicates": "error",
        "import/extensions": [
            "error",
            "ignorePackages",
            {
                "js": "never",
                "mjs": "never",
                "jsx": "never",
                "ts": "never",
                "tsx": "never",
                "cts": "never",
                "mts": "never"
            }
        ],
        "import/newline-after-import": "error",
        // OFF, shadowed not dropped: oxlint's native port anchors its reports on a different line
        // than ESLint's, so ESLint's own rule runs instead as `hosted/prefer-default-export`.
        "import/prefer-default-export": "off",
        "import/no-absolute-path": "error",
        "import/no-webpack-loader-syntax": "error",
        "import/no-named-default": "error",
        "import/no-self-import": "error",
        // ON, and it is the one rule where oxlint is deliberately stricter than ESLint rather than
        // mirroring it: ESLint enables this rule too but reports 0, while oxlint's implementation
        // works. Every finding is a real cycle. Kept on so the cleanup has a number to work against.
        "import/no-cycle": "error",
        "rulesdir/context-provider-split-values": "error",
        "rulesdir/no-acc-spread-in-reduce": "error",
        "rulesdir/no-api-in-views": "error",
        "rulesdir/no-api-side-effects-method": "error",
        "rulesdir/no-beta-handler": "error",
        "rulesdir/no-call-actions-from-actions": "error",
        "rulesdir/no-deep-equal-in-memo": "error",
        "rulesdir/no-default-id-values": "error",
        "rulesdir/no-default-props": "error",
        "rulesdir/no-direct-pre-insert-fullscreen-under-rhp": "error",
        "rulesdir/no-inline-named-export": "error",
        "rulesdir/no-multiple-api-calls": "error",
        "rulesdir/no-multiple-onyx-in-file": "error",
        "rulesdir/no-negated-variables": "error",
        "rulesdir/no-onyx-connect": "error",
        "rulesdir/no-set-or-map-return-in-useOnyx-selector": "error",
        "rulesdir/no-thenable-actions-in-views": "error",
        "rulesdir/no-unstable-hook-defaults": "error",
        "rulesdir/no-use-state-initializer-functions": "error",
        "rulesdir/no-useless-compose": "error",
        "rulesdir/prefer-actions-set-data": "error",
        "rulesdir/prefer-early-return": "error",
        "rulesdir/prefer-localization": "error",
        "rulesdir/prefer-narrow-hook-dependencies": [
            "error",
            {
                "stableObjectPatterns": ["[Ss]tyles?$", "^theme", "[Ii]cons?$"]
            }
        ],
        "rulesdir/prefer-onyx-connect-in-libs": "error",
        "rulesdir/prefer-shouldUseNarrowLayout-instead-of-isSmallScreenWidth": "error",
        "rulesdir/prefer-type-fest": "error",
        "rulesdir/require-a11y-disable-justification": "error",
        "rulesdir/require-live-region-for-status-updates": "error",
        "rulesdir/require-locale-for-localized-date-format": "error",
        "rulesdir/use-double-negation-instead-of-boolean": "error",
        // The four rulesdir rules below are listed as OFF on purpose rather than left out: a rule
        // missing from this file is indistinguishable from an oversight. Each is still wanted — the
        // reason it cannot run yet is on its own line, and the machine-readable copy lives in
        // oxlint-migration/ruleMap.py (PORT_PLAN), printed by `npm run oxlint-rule-availability`.
        // OFF, blocked upstream: needs the type of the `&&` left operand; jsPlugins get no type info.
        "rulesdir/boolean-conditional-rendering": "off",
        // OFF, blocked upstream: needs typeChecker.isArrayType to tell arrays from records, so a
        // syntactic port would fire on every obj[key]. Measured 2026-08-13: unicorn/prefer-at with
        // checkAllIndexAccess reports 413 findings in src/, 0 of the sampled 104 real. The same rule
        // at default options covers the x[x.length - N] half and matches ESLint's own copy of it
        // exactly (2 findings, same 2 lines, whole repo); enabling it on both linters is step 10a of
        // OXLINT_MIGRATION_STEPS.md, pending the two source fixes it needs.
        "rulesdir/prefer-at": "off",
        // OFF here, ON for src/**/*.ts(x) below, mirroring ESLint's scope exactly. ESLint's copy of
        // this rule needs the type checker, so oxlint runs a type-free rewrite
        // (config/oxlint/preferLocaleCompareFromContext.mjs): the only type question it asks is
        // "is the receiver a string", and localeCompare exists on exactly one built-in prototype.
        "rulesdir/prefer-locale-compare-from-context": "off",
        // Wired 2026-08-12 behind the React Compiler gate (config/oxlint/reactCompilerGate.mjs).
        // Without the gate this reports 238 findings across 186 files that ESLint never shows,
        // because its processor drops every message from this rule in a dual-memoized file.
        "rulesdir/no-inline-useOnyx-selector": "error",
        "no-array-constructor": "error",
        "no-bitwise": "error",
        "no-lonely-if": "error",
        "no-multi-assign": ["error"],
        "no-nested-ternary": "error",
        "no-underscore-dangle": [
