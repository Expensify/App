{
    // Shared compiler options only. Extending the native app project inherits its
    // `exclude` of `modules/ExpensifyNitroUtils/**`, which leaves this program empty.
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "tsBuildInfoFile": "./tsconfig.ts7.tsbuildinfo",
        "outDir": "./lib",
        "types": [],
        "lib": ["ESNext"],
        "moduleSuffixes": [".ios", ".android", ".native", ""]
    },
    "include": ["src/**/*"]
}
