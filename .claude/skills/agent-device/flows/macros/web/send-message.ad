context platform=web
# @desc   Send a chat message from inside an already-open chat. Reusable helper for setting up state in other flows. Does not navigate or open a chat - assumes the composer is visible. For the QA scenario that exercises the ManualSendMessageVisible Sentry span, see flows/tests/send-message.ad.
# @pre    role="textbox" label="Write something..."
# @post   role="textbox" label="Write something..."
# @tag    chat
# @param  MESSAGE Message text to send in the currently open chat.

is exists "role=\"textbox\" label=\"Write something...\""
fill "role=\"textbox\" label=\"Write something...\"" "${MESSAGE}"
press "role=\"button\" label=\"Send\" || label=\"Send\""