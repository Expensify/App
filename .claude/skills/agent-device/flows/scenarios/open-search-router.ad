# @desc   Open the SearchRouter from the Inbox tab. Triggers the ManualOpenSearchRouter Sentry span (Search button tap -> SearchRouterPage visible). Assumes the user is signed in.
# @pre    id="BaseSidebarScreen"
# @pre    id="searchButton" || role="button" label="Search"
# @post   id="SearchRouterPage"
# @reset  .claude/skills/agent-device/flows/macros/return-to-inbox.ad
# @tag    navigation
# @tag    perf
# @tag    search
# @tag    sentry-ManualOpenSearchRouter
# @unique-label Inbox. Your review is required
is exists "id=\"BaseSidebarScreen\""
is exists "id=\"searchButton\" || role=\"button\" label=\"Search\""
press "role=\"tab\" label=\"Inbox. Your review is required\" || role=\"tab\" label=\"Inbox\" || label=\"Inbox. Your review is required\" hittable=true || label=\"Inbox\" hittable=true || label=\"Inbox. Your review is required\""
press "id=\"searchButton\" || role=\"button\" label=\"Search\""
wait "id=\"SearchRouterPage\"" 10000
