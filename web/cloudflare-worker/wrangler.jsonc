{
    "$schema": "node_modules/wrangler/config-schema.json",
    // The top level only configures `wrangler dev`. Deploys always pass `--env staging` or `--env production`.
    "name": "new-expensify-assets-local",
    "main": "src/index.ts",
    "compatibility_date": "2026-09-26",
    "workers_dev": false,
    "preview_urls": false,
    // Runs before `wrangler dev` and `wrangler deploy` (from this directory), so .assetsignore is always applied to the upload.
    "build": {
        "command": "./scripts/prepareDist.sh",
        "watch_dir": "src",
    },
    // Issues groups uncaught exceptions, 5xx responses and console.error calls. Each environment's observability block
    // replaces this one, so they all set Issues and traces too; a deploy without them turns them off.
    "observability": {
        "enabled": true,
        "issues": {"enabled": true},
        "traces": {"enabled": true},
    },
    "upload_source_maps": true,
    "assets": {
        "directory": "../../dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        // Serve exact paths, so `/index.html` is not redirected to `/`.
        "html_handling": "none",
        // Every response needs security headers, and HTML needs a per-request CSP nonce, including SPA navigations.
        "run_worker_first": true,
    },
    // Files from previous builds, served when a tab running an older build requests a file the current build
    // doesn't have. `wrangler dev` uses an empty local bucket.
    "r2_buckets": [{"binding": "PREVIOUS_BUILDS", "bucket_name": "new-expensify-web-assets-staging"}],
    "vars": {
        "ENVIRONMENT": "staging",
    },
    // Routes are managed in Cloudflare, not here: syncing routes needs zone access, and the CI deploy token can only
    // edit these Workers.
    "env": {
        // Serves a staging build on test-staging.new.expensify.com, a hostname nobody else uses.
        "test-staging": {
            "name": "test-staging-new-expensify-assets",
            "r2_buckets": [{"binding": "PREVIOUS_BUILDS", "bucket_name": "new-expensify-web-assets-staging"}],
            "vars": {
                "ENVIRONMENT": "staging",
            },
        },
        // Serves nothing until staging.new.expensify.com/* is routed to this Worker.
        "staging": {
            "name": "staging-new-expensify-assets",
            "r2_buckets": [{"binding": "PREVIOUS_BUILDS", "bucket_name": "new-expensify-web-assets-staging"}],
            // The Worker runs for every asset, so logging every request would exceed the included Workers Logs volume.
            // Traces don't inherit head_sampling_rate and default to tracing every request.
            "observability": {
                "enabled": true,
                "head_sampling_rate": 0.1,
                "issues": {"enabled": true},
                "traces": {"enabled": true, "head_sampling_rate": 0.1},
            },
            "vars": {
                "ENVIRONMENT": "staging",
            },
        },
        // Serves nothing on new.expensify.com until new.expensify.com/* is routed to this Worker.
        "production": {
            "name": "new-expensify-assets",
            "r2_buckets": [{"binding": "PREVIOUS_BUILDS", "bucket_name": "new-expensify-web-assets-production"}],
            "observability": {
                "enabled": true,
                "head_sampling_rate": 0.01,
                "issues": {"enabled": true},
                "traces": {"enabled": true, "head_sampling_rate": 0.01},
            },
            "vars": {
                "ENVIRONMENT": "production",
            },
        },
    },
}
