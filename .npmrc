engine-strict=true

# Only resolve package versions published at least 7 days ago: malicious npm releases are
# usually detected and unpublished within hours, so the cooldown outlasts the attack window.
# npm ci and lockfile-clean installs do no resolution and are unaffected.
# Urgent bypass for a reviewed exception: npm install <pkg> --min-release-age=0
min-release-age=7
# Packages Expensify publishes itself are consumed same-day, so they skip the cooldown.
min-release-age-exclude[]=expensify-common
min-release-age-exclude[]=react-native-onyx
min-release-age-exclude[]=eslint-config-expensify
min-release-age-exclude[]=@expensify/react-native-live-markdown
min-release-age-exclude[]=@expensify/react-native-wallet
min-release-age-exclude[]=react-fast-pdf
min-release-age-exclude[]=react-native-key-command
min-release-age-exclude[]=react-native-qrcode-svg
