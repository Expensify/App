engine-strict=true

# Supply chain protection: only resolve package versions published at least 7 days ago.
min-release-age=7
min-release-age-exclude[]=expensify-common
min-release-age-exclude[]=react-native-onyx
min-release-age-exclude[]=eslint-config-expensify
min-release-age-exclude[]=@expensify/react-native-live-markdown
min-release-age-exclude[]=@expensify/react-native-wallet
min-release-age-exclude[]=react-fast-pdf
min-release-age-exclude[]=react-native-key-command
min-release-age-exclude[]=react-native-qrcode-svg

# Temporary: pin of @callstack/repack@5.4.1 predates the age window.
# Remove these entries once a dependency on 5.4.1 has been installable for 7+ days.
min-release-age-exclude[]=@callstack/repack
min-release-age-exclude[]=@callstack/repack-dev-server
min-release-age-exclude[]=@callstack/repack-plugin-expo-modules
min-release-age-exclude[]=@callstack/repack-plugin-reanimated
