{
    "include": ["nsExports", "nsTypes"],
    "workspaces": {
        ".": {
            "entry": [
                "index.js",
                "wdyr.ts",
                "src/App.tsx",
                "src/HybridAppHandler.tsx",
                "scripts/**/*.{js,mjs,ts}",
                "web/proxy.ts",
                "web/service-worker.ts",
                "config/rsbuild/**/*.{js,mjs,cjs,ts}",
                "config/repack/**/*.{js,mjs,ts}",
                ".github/scripts/**/*.ts",
                "tests/tooling/**/*.ts",
                ".github/actions/javascript/**/*.ts",
                "tests/globals.d.ts",
                ".storybook/**/*.{js,ts,tsx}",
                "config/babel/oxcJestTransformer.js",
                "react-native.config.js",
                "rock.config.mjs",
                "rspack.config.mjs",
                "tests/perf-test/**/*.perf-test.{ts,tsx}",
                "tests/perf-local/**/*.perf-local.ts"
            ],
            "project": [
                "src/**/*.{js,jsx,ts,tsx}",
                "tests/**/*.{js,jsx,ts,tsx}",
                "__mocks__/**/*.{js,jsx,ts,tsx}",
                "web/**/*.{js,jsx,ts,tsx}",
                "config/**/*.{js,mjs,ts,tsx}",
                "scripts/**/*.{js,ts}",
                "jest/**/*.{js,ts}",
                ".storybook/**/*.{js,ts,tsx}",
                ".github/actions/javascript/**/*.ts"
            ],
            "ignore": [".github/actions/**/index.js", "web/snippets/gib.js", "web/cloudflare-worker/**"],
            "rsbuild": {
                "config": ["config/rsbuild/rsbuild.config.ts", ".storybook/rsbuild.config.ts"]
            },
            "babel": {
                "config": ["babel.config.js"]
            },
            "jest": {
                "config": ["jest.config.js"]
            },
            "storybook": {
                "config": [".storybook/main.ts"]
            }
        },
        "modules/ExpensifyNitroUtils": {
            "bun": false
        },
        "server/victory-chart-renderer": {
            "bun": false,
            "entry": ["src/bootstrap.tsx", "tests/**/*.test.ts"],
            "project": ["src/**/*.{ts,tsx}", "scripts/**/*.ts", "tests/**/*.{ts,tsx}"]
        }
    },
    "ignoreDependencies": [
        "focus-trap",
        "react-native-quick-crypto",
        "react-native-quick-base64",
        "@babel/plugin-proposal-private-methods",
        "@babel/plugin-proposal-private-property-in-object",
        "@babel/plugin-transform-export-namespace-from",
        "babel-plugin-module-resolver",
        "babel-plugin-transform-remove-console",
        "html-entities",
        "@fullstory/babel-plugin-react-native",
        "@fullstory/babel-plugin-annotate-react",
        "eslint-plugin-react-hooks",
        "eslint-plugin-jsdoc",
        "eslint-plugin-storybook",
        "shellcheck",
        "patch-package",
        "diff-so-fancy"
    ],
    "ignoreBinaries": ["mkcert", "openssl", "xdg-open", "ruby"],
    "ignoreIssues": {
        "config/oxlint/ruleNames.mjs": ["exports"],
        "rock.config.mjs": ["unlisted"],
        "src/libs/SearchParser/searchParser.js": ["exports"],
        "src/libs/SearchParser/autocompleteParser.js": ["exports"],
        "src/libs/actions/connections/Digits.ts": ["exports"]
    }
}
