{
    "$schema": "../../node_modules/oxlint/configuration_schema.json",
    // The production plugins are loaded directly, so a fixture failure means the shipped
    // config regressed — not that a probe copy drifted. ./port-plugin.mjs holds only the
    // rules that are still candidates.
    "jsPlugins": ["../core-rules.mjs", "../hosted-rules.mjs", "../expensify-rules.mjs", "./port-plugin.mjs"],
    "categories": {},
    "rules": {
        "core/no-unreachable-loop": ["error", {"ignore": []}],
        "hosted/jsx-no-bind": ["error", {"ignoreRefs": true, "allowArrowFunctions": true, "allowFunctions": false, "allowBind": false, "ignoreDOMComponents": true}],
        "hosted/function-component-definition": ["error", {"namedComponents": "function-declaration", "unnamedComponents": "arrow-function"}],
        "hosted/prefer-default-export": "error",
        "hosted/order": ["error", {"groups": [["builtin", "external", "internal"]], "distinctGroup": true, "sortTypesGroup": false, "named": false, "warnOnUnassignedImports": false}],
        "hosted/no-types": "error",
        "hosted/naming-convention": [
            "error",
            {"selector": ["variable", "property"], "format": null, "filter": {"regex": "^__esModule$", "match": true}},
            {"selector": ["variable", "property"], "format": ["camelCase", "UPPER_CASE", "PascalCase"], "filter": {"regex": "^private_[a-z][a-zA-Z0-9]*$", "match": false}},
            {"selector": "function", "format": ["camelCase", "PascalCase"]},
            {"selector": ["typeLike", "enumMember"], "format": ["PascalCase"]},
            {"selector": ["parameter", "method"], "format": ["camelCase", "PascalCase"], "leadingUnderscore": "allow"}
        ],
        "rulesdir/no-inline-useOnyx-selector": "error",
        "pp/jsx-no-constructed-context-values": "error"
    },
    "overrides": [
        {
            // These three are ESLint plugins hosted by oxlint's JS sidecar, exactly as the
            // production config does it: `jsPlugins` accepts bare npm package specifiers, and the
            // rule prefix is then the plugin's own meta.name minus the eslint-plugin- marker.
            // Declaring them in the root `rules` block instead fails with "Plugin '<name>' not found".
            "files": ["**/*.ts", "**/*.tsx"],
            "jsPlugins": ["eslint-plugin-you-dont-need-lodash-underscore", "eslint-plugin-testing-library", "eslint-plugin-react-native-a11y"],
            "rules": {
                "you-dont-need-lodash-underscore/uniq": "error",
                "testing-library/no-debugging-utils": "error",
                "react-native-a11y/has-valid-accessibility-descriptors": "error"
            }
        }
    ]
}
