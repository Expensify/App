{
    "$schema": "../../node_modules/oxlint/configuration_schema.json",
    "jsPlugins": ["./port-plugin.mjs"],
    "categories": {},
    "rules": {
        "pp/no-unreachable-loop": ["error", {"ignore": []}],
        "pp/jsx-no-bind": ["error", {"ignoreRefs": true, "allowArrowFunctions": true, "allowFunctions": false, "allowBind": false, "ignoreDOMComponents": true}],
        "pp/function-component-definition": ["error", {"namedComponents": "function-declaration", "unnamedComponents": "arrow-function"}],
        "pp/jsx-no-constructed-context-values": "error",
        "pp/prefer-default-export": "error",
        "pp/order": ["error", {"groups": [["builtin", "external", "internal"]]}],
        "pp/no-types": "error",
        "pp/no-inline-useOnyx-selector": "error"
    },
    "overrides": [
        {
            // These three are ESLint plugins hosted by oxlint's JS sidecar, exactly as the
            // production config does it: `jsPlugins` accepts bare npm package specifiers, and the
            // rule prefix is then the plugin's own meta.name. Declaring the rules in the root
            // `rules` block instead fails with "Plugin '<name>' not found".
            "files": ["**/*.ts", "**/*.tsx"],
            "jsPlugins": ["eslint-plugin-you-dont-need-lodash-underscore", "eslint-plugin-testing-library", "eslint-plugin-react-native-a11y"],
            "rules": {
                "you-dont-need-lodash-underscore/uniq": "error",
                "testing-library/no-debugging-utils": "error",
                "react-native-a11y/has-valid-accessibility-descriptors": "error"
            }
        }
    ]
}
