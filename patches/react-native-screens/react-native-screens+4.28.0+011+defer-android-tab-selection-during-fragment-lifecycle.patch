+package com.swmansion.rnscreens.gamma.tabs.screen
+
+import androidx.annotation.MainThread
+import androidx.fragment.app.FragmentManager
+import java.util.WeakHashMap
+
+/** Tracks callbacks that can synchronously flush Fabric updates into the same FragmentManager. */
+@MainThread
+internal object TabsScreenFragmentLifecycleTracker {
+    private val callbackDepth = WeakHashMap<FragmentManager, Int>()
+
+    fun onCallbackStarted(fragmentManager: FragmentManager) {
+        callbackDepth[fragmentManager] = (callbackDepth[fragmentManager] ?: 0) + 1
+    }
+
+    fun onCallbackFinished(fragmentManager: FragmentManager) {
+        val depth = (callbackDepth[fragmentManager] ?: 0) - 1
+        if (depth > 0) {
+            callbackDepth[fragmentManager] = depth
+        } else {
+            callbackDepth.remove(fragmentManager)
+        }
+    }
+
+    fun isRunningCallback(fragmentManager: FragmentManager): Boolean = (callbackDepth[fragmentManager] ?: 0) > 0
+}
