+  // The bar is shown only above the root of the stack, so only the transitions between the root and the next screen
+  // move it. The screen leaving a pop is no longer in the stack.
+  UIViewController *from = [coordinator viewControllerForKey:UITransitionContextFromViewControllerKey];
+  NSUInteger toIndex = [stackController.viewControllers indexOfObject:target];
+  NSUInteger fromIndex = [stackController.viewControllers indexOfObject:from];
+  BOOL hiding = toIndex == 1 && fromIndex == 0;
+  BOOL showing = toIndex == 0 && fromIndex == NSNotFound;
