+- (void)stepTabBarStrip:(CADisplayLink *_Nullable)link
+{
+  UIView *edgeView = _tabBarEdgeView;
+  UIView *rootView = _tabBarRootView;
+  UIView *clipView = _tabBarClipView;
+  if (edgeView == nil || rootView == nil || clipView == nil) {
+    return;
+  }
+  CGFloat edgeX = (edgeView.layer.presentationLayer ?: edgeView.layer).frame.origin.x;
+  CGFloat rootX = (rootView.layer.presentationLayer ?: rootView.layer).frame.origin.x;
+  CGFloat width = _tabBarContainerSize.width;
+  CGFloat maskedEdge = MAX(0, MIN(width, edgeX));
+  CGRect screenFrame = CGRectMake(maskedEdge, -clipView.frame.origin.y, width + _tabBarCornerRadius, _tabBarContainerSize.height);
+  UIBezierPath *path = [UIBezierPath bezierPathWithRect:clipView.bounds];
+  [path appendPath:[UIBezierPath bezierPathWithRoundedRect:screenFrame cornerRadius:_tabBarCornerRadius]];
+  [CATransaction begin];
+  [CATransaction setDisableActions:YES];
+  _tabBarClipMask.frame = clipView.bounds;
+  _tabBarClipMask.path = path.CGPath;
+  // UIKit lays the bar out again while it is shown and can bring its glass back.
+  _tabBarHiddenPlatter.alpha = 0;
+  [CATransaction commit];
+  clipView.subviews.firstObject.frame = CGRectMake(_tabBarStripFrame.origin.x + MIN(0, rootX), 0, _tabBarStripFrame.size.width, _tabBarStripFrame.size.height);
+}
