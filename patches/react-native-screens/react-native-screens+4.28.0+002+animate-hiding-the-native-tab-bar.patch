+          tabBar.accessibilityElementsHidden = NO;
+        }
+        auto strongSelf = weakSelf;
+        if (strongSelf != nil) {
+          strongSelf->_tabBarHiddenPlatter = nil;
+          [strongSelf->_tabBarStripLink invalidate];
+          strongSelf->_tabBarStripLink = nil;
+          [strongSelf->_tabBarClipView removeFromSuperview];
+          strongSelf->_tabBarClipView = nil;
+          strongSelf->_tabBarClipMask = nil;
