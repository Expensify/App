+  [_tabBarFadeOutAnimator addCompletion:^(UIViewAnimatingPosition finalPosition) {
+    auto strongSelf = weakSelf;
+    if (strongSelf != nil) {
+      strongSelf->_tabBarFadeOutAnimator = nil;
+      if (finalPosition == UIViewAnimatingPositionEnd) {
+        [strongSelf->_controller setTabBarHidden:YES animated:NO];
+      }
+    }
+    tabBar.alpha = 1;
+    tabBar.userInteractionEnabled = YES;
+  }];
+  [_tabBarFadeOutAnimator startAnimation];
+}
