+#pragma mark - Tab bar visibility
+
+static UIView *_Nullable RNSDirectChildAncestor(UIView *_Nullable view, UIView *container)
+{
+  while (view != nil && view.superview != container) {
+    view = view.superview;
+  }
+  return view;
+}
+
+static BOOL RNSControllerIsInside(UIViewController *_Nullable controller, UIViewController *_Nullable ancestor)
+{
+  for (UIViewController *current = controller; current != nil; current = current.parentViewController) {
+    if (current == ancestor) {
+      return YES;
+    }
+  }
+  return NO;
+}
+
+// The glass the tab items sit on is a private view of the bar, found by its class name.
+static UIView *_Nullable RNSTabBarPlatter(UITabBar *tabBar)
+{
+  for (UIView *subview in tabBar.subviews) {
+    if ([NSStringFromClass([subview class]) hasSuffix:@"PlatterView"]) {
+      return subview;
+    }
+  }
+  return nil;
+}
+
+/**
+ * A screen pushed in the selected tab's stack slides over the bar, so the bar travels with the screen it leaves, the way
+ * a screen pushed above the whole tab navigator takes the bar along: it moves with that screen and the screen sliding
+ * in covers it, a little more with every step of an interactive swipe back. The real bar sits above every screen, so a
+ * picture of it goes between the two screens for the length of the transition. The host has to join the transition
+ * before it starts, which is why the stack notifies it, and the transition covers a cancelled swipe back as well.
+ */
