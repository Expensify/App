+#pragma mark - Tab bar visibility
+
+/**
+ * UIKit's hide animation on iOS 26 clears the tab items before it fades the glass, while its show animation brings both
+ * in together. The bar fades out as a whole here instead and is hidden without animation once invisible. Showing it
+ * again mid-fade reverses the fade, so the bar never ends up hidden while it should be shown.
+ */
+- (void)applyTabBarHiddenWithFade API_AVAILABLE(ios(26.0))
+{
+  if (_tabBarFadeOutAnimator != nil) {
+    _tabBarFadeOutAnimator.reversed = !_tabBarHidden;
+    return;
+  }
+
+  UITabBar *tabBar = _controller.tabBar;
+  // Before the bar is on screen, the first render would otherwise animate it out.
+  if (!_tabBarHidden || tabBar.window == nil) {
+    [_controller setTabBarHidden:_tabBarHidden animated:tabBar.window != nil];
+    return;
+  }
+
+  if (_controller.isTabBarHidden) {
+    return;
+  }
+
+  tabBar.userInteractionEnabled = NO;
+  _tabBarFadeOutAnimator = [[UIViewPropertyAnimator alloc] initWithDuration:0.2
+                                                                      curve:UIViewAnimationCurveEaseOut
+                                                                 animations:^{
+                                                                   tabBar.alpha = 0;
+                                                                 }];
+  __weak auto weakSelf = self;
+  [_tabBarFadeOutAnimator addCompletion:^(UIViewAnimatingPosition finalPosition) {
+    auto strongSelf = weakSelf;
+    if (strongSelf != nil) {
+      strongSelf->_tabBarFadeOutAnimator = nil;
+      if (finalPosition == UIViewAnimatingPositionEnd) {
+        [strongSelf->_controller setTabBarHidden:YES animated:NO];
+      }
+    }
+    tabBar.alpha = 1;
+    tabBar.userInteractionEnabled = YES;
+  }];
+  [_tabBarFadeOutAnimator startAnimation];
+}
