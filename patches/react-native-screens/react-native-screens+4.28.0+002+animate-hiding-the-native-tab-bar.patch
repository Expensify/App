+#pragma mark - Tab bar visibility
+
+/**
+ * UIKit's hide animation on iOS 26 clears the tab items before it fades the glass, while its show animation brings both
+ * in together. The bar fades out as a whole here instead and is hidden without animation once invisible. Showing it
+ * again mid-fade reverses the fade, so the bar never ends up hidden while it should be shown.
+ */
+- (nullable UINavigationController *)findStackControllerIn:(UIViewController *)controller
+{
+  if ([controller isKindOfClass:UINavigationController.class]) {
+    return (UINavigationController *)controller;
+  }
+  for (UIViewController *child in controller.childViewControllers) {
+    UINavigationController *stackController = [self findStackControllerIn:child];
+    if (stackController != nil) {
+      return stackController;
+    }
+  }
+  return nil;
+}
+
+/**
+ * A screen pushed in the selected tab's stack slides over the bar, so the bar travels with the screen it leaves, the way
+ * a screen pushed above the whole tab navigator takes the bar along. The bar moves like the outgoing screen does and
+ * fades out while the incoming screen covers it. Running in the stack's transition keeps it in step with the push, and
+ * with an interactive swipe back, including when that is cancelled.
+ */
+- (BOOL)animateTabBarAlongsideStackTransition API_AVAILABLE(ios(26.0))
+{
+  UITabBar *tabBar = _controller.tabBar;
+  UINavigationController *stackController = [self findStackControllerIn:_controller.selectedViewController];
+  id<UIViewControllerTransitionCoordinator> coordinator = stackController.transitionCoordinator;
+  if (coordinator == nil || tabBar.window == nil) {
+    return NO;
+  }
+
+  BOOL hiding = _tabBarHidden;
+  CGAffineTransform awayTransform = CGAffineTransformMakeTranslation(-tabBar.bounds.size.width * 0.3, 0);
+  if (!hiding) {
+    [_controller setTabBarHidden:NO animated:NO];
+    tabBar.transform = awayTransform;
+    tabBar.alpha = 0;
+  }
+  tabBar.userInteractionEnabled = NO;
+
+  __weak auto weakSelf = self;
+  [coordinator animateAlongsideTransition:^(id<UIViewControllerTransitionCoordinatorContext> _Nonnull context) {
+    tabBar.transform = hiding ? awayTransform : CGAffineTransformIdentity;
+    tabBar.alpha = hiding ? 0 : 1;
+  }
+      completion:^(id<UIViewControllerTransitionCoordinatorContext> _Nonnull context) {
+        auto strongSelf = weakSelf;
+        BOOL endsHidden = context.isCancelled ? !hiding : hiding;
+        tabBar.transform = CGAffineTransformIdentity;
+        tabBar.alpha = 1;
+        tabBar.userInteractionEnabled = YES;
+        if (strongSelf != nil) {
+          [strongSelf->_controller setTabBarHidden:endsHidden animated:NO];
+        }
+      }];
+  return YES;
+}
+
+- (void)applyTabBarHiddenWithFade API_AVAILABLE(ios(26.0))
+{
+  if (_tabBarFadeOutAnimator != nil) {
+    _tabBarFadeOutAnimator.reversed = !_tabBarHidden;
+    return;
+  }
+
+  UITabBar *tabBar = _controller.tabBar;
+  if (tabBar.window != nil) {
+    if ([self animateTabBarAlongsideStackTransition]) {
+      return;
+    }
+    // The stack starts its push after the host receives the prop, so its transition is looked up again one turn later.
+    if (!_isRetryingTabBarVisibility) {
+      _isRetryingTabBarVisibility = YES;
+      __weak auto weakSelf = self;
+      dispatch_async(dispatch_get_main_queue(), ^{
+        auto strongSelf = weakSelf;
+        if (strongSelf != nil) {
+          [strongSelf applyTabBarHiddenWithFade];
+          strongSelf->_isRetryingTabBarVisibility = NO;
+        }
+      });
+      return;
+    }
+  }
+
+  // Before the bar is on screen, the first render would otherwise animate it out.
+  if (!_tabBarHidden || tabBar.window == nil) {
+    [_controller setTabBarHidden:_tabBarHidden animated:tabBar.window != nil];
+    return;
+  }
+
+  if (_controller.isTabBarHidden) {
+    return;
+  }
+
+  tabBar.userInteractionEnabled = NO;
+  _tabBarFadeOutAnimator = [[UIViewPropertyAnimator alloc] initWithDuration:0.2
+                                                                      curve:UIViewAnimationCurveEaseOut
+                                                                 animations:^{
+                                                                   tabBar.alpha = 0;
+                                                                 }];
+  __weak auto weakSelf = self;
+  [_tabBarFadeOutAnimator addCompletion:^(UIViewAnimatingPosition finalPosition) {
+    auto strongSelf = weakSelf;
+    if (strongSelf != nil) {
+      strongSelf->_tabBarFadeOutAnimator = nil;
+      if (finalPosition == UIViewAnimatingPositionEnd) {
+        [strongSelf->_controller setTabBarHidden:YES animated:NO];
+      }
+    }
+    tabBar.alpha = 1;
+    tabBar.userInteractionEnabled = YES;
+  }];
+  [_tabBarFadeOutAnimator startAnimation];
+}
