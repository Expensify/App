+/**
+ * UIKit's hide animation on iOS 26 clears the tab items before it fades the glass, while its show animation brings both
+ * in together. When no stack transition moves the bar, it fades out as a whole instead and is hidden without animation
+ * once invisible. Showing it again mid-fade reverses the fade, so the bar never ends up hidden while it should be shown.
+ */
+- (void)applyTabBarHiddenWithFade API_AVAILABLE(ios(26.0))
+{
+  _tabBarRetryToken++;
+  _tabBarRetries = 0;
+  [self attemptTabBarHiddenWithToken:_tabBarRetryToken];
+}
