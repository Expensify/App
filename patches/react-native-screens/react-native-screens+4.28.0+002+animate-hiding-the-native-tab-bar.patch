+    // glass the items sit on, and the margin leaves room for its edge.
+    UIView *platter = RNSTabBarPlatter(tabBar);
+    CGRect barRect = [window convertRect:(platter ?: tabBar).bounds fromView:platter ?: tabBar];
+    CGRect stripRect = CGRectInset(barRect, -3, -3);
