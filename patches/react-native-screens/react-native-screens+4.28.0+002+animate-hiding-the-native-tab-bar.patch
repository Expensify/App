+- (void)attemptTabBarHiddenWithToken:(NSUInteger)token API_AVAILABLE(ios(26.0))
+{
+  if (token != _tabBarRetryToken) {
+    return;
+  }
+  if (_tabBarFadeOutAnimator != nil) {
+    _tabBarFadeOutAnimator.reversed = !_tabBarHidden;
+    return;
+  }
+
+  UITabBar *tabBar = _controller.tabBar;
+  if (tabBar.window != nil) {
+    if (_tabBarTransitionCoordinator != nil) {
+      return;
+    }
+    // The stack starts its push some turns after the host receives the prop and takes over from there, so the bar is
+    // only hidden by itself when no transition shows up.
+    if (_tabBarRetries < 12) {
+      _tabBarRetries++;
+      __weak auto weakSelf = self;
+      dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 16 * NSEC_PER_MSEC), dispatch_get_main_queue(), ^{
+        [weakSelf attemptTabBarHiddenWithToken:token];
+      });
+      return;
+    }
+  }
