+/**
+ * Keeps a picture of the tab bar between the two screens of a stack transition, read from where those screens are drawn
+ * on every frame, so it stays in step with the transition and with a swipe back at any speed. The picture moves with
+ * the root screen and is cut at the edge of the screen that slides over it.
+ */
+@interface RNSTabBarStripFollower : NSObject
+
+- (instancetype)initWithStripView:(UIView *)stripView
+                            frame:(CGRect)frame
+                     cornerRadius:(CGFloat)cornerRadius
+                         rootView:(UIView *)rootView
+                         edgeView:(UIView *)edgeView
+                    hiddenPlatter:(UIView *_Nullable)platter
+                           tabBar:(UITabBar *)tabBar;
+- (void)stop;
+
+@end
+
+@implementation RNSTabBarStripFollower {
+  UIView *_clipView;
+  UIView *_stripView;
+  CAShapeLayer *_mask;
+  CADisplayLink *_link;
+  CGFloat _width;
+  __weak UIView *_rootView;
+  __weak UIView *_edgeView;
+  __weak UIView *_hiddenPlatter;
+  __weak UITabBar *_tabBar;
+}
+
+- (instancetype)initWithStripView:(UIView *)stripView
+                            frame:(CGRect)frame
+                     cornerRadius:(CGFloat)cornerRadius
+                         rootView:(UIView *)rootView
+                         edgeView:(UIView *)edgeView
+                    hiddenPlatter:(UIView *_Nullable)platter
+                           tabBar:(UITabBar *)tabBar
+{
+  if (self = [super init]) {
+    UIView *container = rootView.superview;
+    CGSize size = container.bounds.size;
+    _width = size.width;
+    _rootView = rootView;
+    _edgeView = edgeView;
+    _clipView = [[UIView alloc] initWithFrame:CGRectMake(0, frame.origin.y, size.width, frame.size.height)];
+    // The screen sliding over the picture has rounded corners like the display, so the picture shows where that screen
+    // is not, which is not a straight line down at the bottom. The cut-out follows the edge by moving the mask.
+    UIBezierPath *path =
+        [UIBezierPath bezierPathWithRect:CGRectMake(-size.width, 0, 3 * size.width + cornerRadius, frame.size.height)];
+    [path appendPath:[UIBezierPath bezierPathWithRoundedRect:CGRectMake(0, -frame.origin.y, size.width + cornerRadius, size.height)
+                                                cornerRadius:cornerRadius]];
+    _mask = [CAShapeLayer layer];
+    _mask.fillRule = kCAFillRuleEvenOdd;
+    _mask.frame = _clipView.bounds;
+    _mask.path = path.CGPath;
+    _clipView.layer.mask = _mask;
+    _stripView = stripView;
+    _stripView.transform = CGAffineTransformIdentity;
+    _stripView.frame = CGRectMake(frame.origin.x, 0, frame.size.width, frame.size.height);
+    [_clipView addSubview:_stripView];
+    [container insertSubview:_clipView aboveSubview:rootView];
+
+    if (platter != nil) {
+      platter.alpha = 0;
+      tabBar.userInteractionEnabled = NO;
+      tabBar.accessibilityElementsHidden = YES;
+      _hiddenPlatter = platter;
+      _tabBar = tabBar;
+    }
+
+    _link = [CADisplayLink displayLinkWithTarget:self selector:@selector(step:)];
+    _link.preferredFrameRateRange = CAFrameRateRangeMake(60, 120, 120);
+    [_link addToRunLoop:[NSRunLoop mainRunLoop] forMode:NSRunLoopCommonModes];
+    [self step:nil];
+  }
+  return self;
+}
+
+- (void)step:(CADisplayLink *_Nullable)link
+{
+  UIView *edgeView = _edgeView;
+  UIView *rootView = _rootView;
+  if (edgeView == nil || rootView == nil) {
+    return;
+  }
+  CGFloat edgeX = (edgeView.layer.presentationLayer ?: edgeView.layer).frame.origin.x;
+  CGFloat rootX = (rootView.layer.presentationLayer ?: rootView.layer).frame.origin.x;
+  [CATransaction begin];
+  [CATransaction setDisableActions:YES];
+  _mask.transform = CATransform3DMakeTranslation(MAX(0, MIN(_width, edgeX)), 0, 0);
+  // UIKit lays the bar out again while it is shown and can bring its glass back.
+  _hiddenPlatter.alpha = 0;
+  [CATransaction commit];
+  _stripView.transform = CGAffineTransformMakeTranslation(MIN(0, rootX), 0);
+}
+
+- (void)stop
+{
+  [_link invalidate];
+  _link = nil;
+  [_clipView removeFromSuperview];
+  UITabBar *tabBar = _tabBar;
+  if (tabBar != nil) {
+    _hiddenPlatter.alpha = 1;
+    tabBar.userInteractionEnabled = YES;
+    tabBar.accessibilityElementsHidden = NO;
+  }
+}
+
+@end
