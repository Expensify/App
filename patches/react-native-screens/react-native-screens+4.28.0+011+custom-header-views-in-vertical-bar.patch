+// The custom view of a header subview's bar button item. On a foldable iPhone UIKit hosts the items of the vertical
+// bar in views that it builds again when the traits of the bar change, as on a rotation or a fold. It can then leave a
+// custom view out of every host, so this view tells its header subview when it has no superview any more.
+@interface RNSScreenStackHeaderSubviewBarItemView : UIView
+@property (nonatomic, weak) RNSScreenStackHeaderSubview *headerSubview;
+@end
+
+@implementation RNSScreenStackHeaderSubviewBarItemView
+
+- (void)didMoveToSuperview
+{
+  [super didMoveToSuperview];
+  if (self.superview == nil) {
+    [self.headerSubview barButtonItemViewDidLoseSuperview];
+  }
+}
+
+@end
