+
+- (void)barButtonItemViewDidLoseSuperview
+{
+#if RNS_IPHONE_OS_VERSION_AVAILABLE(27_1) && !TARGET_OS_TV && !TARGET_OS_VISION
+  if (@available(iOS 27.1, *)) {
+    if (_barButtonItem == nil || _isBarButtonItemRestoreScheduled) {
+      return;
+    }
+    _isBarButtonItemRestoreScheduled = YES;
+    // UIKit may be moving the view from one host to another, so whether it left the view out is only known once it
+    // is done with the bar.
+    __weak RNSScreenStackHeaderSubview *weakSelf = self;
+    dispatch_async(dispatch_get_main_queue(), ^{
+      [weakSelf restoreBarButtonItemIfDropped];
+    });
+  }
+#endif // RNS_IPHONE_OS_VERSION_AVAILABLE(27_1) && !TARGET_OS_TV && !TARGET_OS_VISION
+}
+
+- (void)restoreBarButtonItemIfDropped
+{
+  _isBarButtonItemRestoreScheduled = NO;
+
+  UIBarButtonItem *barButtonItem = _barButtonItem;
+  if (barButtonItem == nil || barButtonItem.customView.superview != nil) {
+    return;
+  }
+
+  RNSScreenStackHeaderConfig *headerConfig = [self getHeaderConfig];
+  UIViewController *vc = headerConfig.screenView.controller;
+  UINavigationController *navctr = vc.navigationController;
+  // A bar that is hidden, or that shows the items of another screen, has none of this screen's views on purpose.
+  if (navctr == nil || navctr.topViewController != vc || navctr.navigationBarHidden ||
+      ![headerConfig shouldHeaderBeVisible]) {
+    return;
+  }
+
+  UINavigationItem *navitem = vc.navigationItem;
+  if (![navitem.leftBarButtonItems containsObject:barButtonItem] &&
+      ![navitem.rightBarButtonItems containsObject:barButtonItem]) {
+    return;
+  }
+
+  // UIKit does not host the view of an item again when it gets the same item, so the subview needs a new one.
+  _barButtonItem = nil;
+  [RNSScreenStackHeaderConfig willShowViewController:vc animated:NO withConfig:headerConfig];
