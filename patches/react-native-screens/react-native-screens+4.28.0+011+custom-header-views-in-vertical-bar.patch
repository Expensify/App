+#if RNS_IPHONE_OS_VERSION_AVAILABLE(27_1) && !TARGET_OS_TV && !TARGET_OS_VISION
+  // On a foldable iPhone UIKit moves bar items into the vertical bar, but with the automatic behavior it keeps an
+  // item with a custom view in the top bar. Preferring the vertical bar lets a custom view follow the other items.
+  if (@available(iOS 27.1, *)) {
