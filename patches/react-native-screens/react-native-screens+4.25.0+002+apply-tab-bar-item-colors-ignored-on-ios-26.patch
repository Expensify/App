diff --git a/node_modules/react-native-screens/ios/tabs/RNSTabBarAppearanceCoordinator.mm b/node_modules/react-native-screens/ios/tabs/RNSTabBarAppearanceCoordinator.mm
index ae5873c..33e35b1 100644
--- a/node_modules/react-native-screens/ios/tabs/RNSTabBarAppearanceCoordinator.mm
+++ b/node_modules/react-native-screens/ios/tabs/RNSTabBarAppearanceCoordinator.mm
@@ -40,6 +40,29 @@ - (void)updateAppearanceOfTabBar:(nullable UITabBar *)tabBar
 
     [self configureTabBarItemForTabScreenController:tabScreenCtrl imageLoader:imageLoader];
   }
+
+  // Step 3 - mirror the unselected item color onto the bar itself.
+  // iOS 26 renders the tab bar's own glass material and ignores the unselected colors carried by the per-item
+  // UITabBarItemAppearance, which leaves unselected titles on the system label color. unselectedItemTintColor is a
+  // bar-level property and is still honored, so the color the screens already carry is reused for it.
+  [self updateUnselectedItemTintColorOfTabBar:tabBar fromTabScreenControllers:tabScreenCtrls];
+}
+
+- (void)updateUnselectedItemTintColorOfTabBar:(nonnull UITabBar *)tabBar
+                     fromTabScreenControllers:(nonnull NSArray<RNSTabsScreenViewController *> *)tabScreenCtrls
+{
+  for (RNSTabsScreenViewController *tabScreenCtrl in tabScreenCtrls) {
+    UITabBarAppearance *standardAppearance = tabScreenCtrl.tabScreenComponentView.standardAppearance;
+    if (standardAppearance == nil) {
+      continue;
+    }
+
+    UIColor *unselectedColor = standardAppearance.stackedLayoutAppearance.normal.iconColor;
+    if (unselectedColor != nil) {
+      tabBar.unselectedItemTintColor = unselectedColor;
+      return;
+    }
+  }
 }
 
 - (void)configureTabBarItemForTabScreenController:(nonnull RNSTabsScreenViewController *)tabScreenCtrl
@@ -50,6 +73,11 @@ - (void)configureTabBarItemForTabScreenController:(nonnull RNSTabsScreenViewCont
   tabBarItem.standardAppearance = tabScreenCtrl.tabScreenComponentView.standardAppearance;
   tabBarItem.scrollEdgeAppearance = tabScreenCtrl.tabScreenComponentView.scrollEdgeAppearance;
 
+  // The badge color reaches the bar through the same per-item appearance, so on iOS 26 every badge ends up drawn in
+  // the color of whichever tab is selected. Setting it on the item's own badgeColor keeps each tab's color with that
+  // tab: a plain UITabBarItem property, the same kind as the icons below, which the new bar does honor.
+  tabBarItem.badgeColor = tabScreenCtrl.tabScreenComponentView.standardAppearance.stackedLayoutAppearance.normal.badgeBackgroundColor;
+
   [self setIconsForTabBarItem:tabBarItem
                fromScreenView:tabScreenCtrl.tabScreenComponentView
               withImageLoader:imageLoader];
