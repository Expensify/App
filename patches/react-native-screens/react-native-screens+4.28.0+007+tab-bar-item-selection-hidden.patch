+- (void)updateTabBarItemSelectionIn:(UIView *)view
+{
+  for (UIView *subview in view.subviews) {
+    NSString *className = NSStringFromClass(subview.class);
+    if ([className hasSuffix:@"LiquidLensView"] || [className hasSuffix:@"SelectedContentView"] ||
+        [className hasSuffix:@"DestOutView"]) {
+      subview.hidden = _tabBarItemSelectionHidden;
+    } else {
+      [self updateTabBarItemSelectionIn:subview];
+    }
+  }
+}
