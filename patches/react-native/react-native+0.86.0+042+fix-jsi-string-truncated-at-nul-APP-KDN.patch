 {
-  return [NSString stringWithUTF8String:value.utf8(runtime).c_str()];
+  // The jsi::String already knows its own byte length. Passing `.c_str()` to `stringWithUTF8String:`
+  // throws that length away and makes it re-derive one with `strlen`, which stops at the first NUL
