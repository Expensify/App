+
+#include <gtest/gtest.h>
+
+#include <react/renderer/mounting/MountingTransaction.h>
+#include <react/renderer/mounting/ShadowViewMutation.h>
+#include <react/renderer/telemetry/TransactionTelemetry.h>
+
+using namespace facebook::react;
+
+/*
+ * Regression coverage for Expensify/App#98791 (Sentry APP-7AR / APP-H7A):
+ * Android Fabric's `FabricUIManagerBinding::schedulerDidFinishTransaction`
+ * used to pick its merge target with a forward `find_if(begin(), end())`
+ * over `pendingTransactions_`, i.e. the *oldest* pending transaction for a
+ * surface. Once patch +015's `MountingTransaction::canMergeWith` guard can
+ * refuse a merge (so a surface can hold more than one pending transaction),
+ * a new transaction could merge into an older entry and execute before an
+ * intervening transaction it was actually diffed against, corrupting
+ * native-vs-shadow tree order. The fix (this patch) searches from the back
+ * (`rbegin()/rend()`) so a new transaction only ever merges into the
+ * *newest* pending entry for its surface.
+ *
+ * `FabricUIManagerBinding` itself is a JNI-bound Android class and isn't
+ * instantiable in a plain ReactCommon gtest, so these cases exercise
+ * `MountingTransaction` directly (pure C++, no JNI dependency) and model
+ * `pendingTransactions_` as a local `std::vector<MountingTransaction>`,
+ * applying the exact selection logic from
+ * `FabricUIManagerBinding.cpp`'s `schedulerDidFinishTransaction`.
+ *
+ * Caveat: because case 3 duplicates that lookup rather than calling the
+ * real (JNI-bound) one, it cannot catch a future edit to the real lookup
+ * in `FabricUIManagerBinding.cpp` diverging from this copy. If that logic
+ * changes again, update this test's copy to match.
+ */
+
+namespace {
+
+constexpr SurfaceId kSurfaceId = 11;
+
+ShadowView viewWithTag(Tag tag) {
+  ShadowView view{};
+  view.tag = tag;
+  return view;
+}
+
+MountingTransaction makeTransaction(
+    MountingTransaction::Number number,
+    ShadowViewMutationList&& mutations) {
+  return MountingTransaction{
+      kSurfaceId, number, std::move(mutations), TransactionTelemetry{}};
+}
+
+} // namespace
+
+class MountingTransactionMergeOrderTest : public ::testing::Test {};
+
+/*
+ * Case 1 — baseline regression guard for patch +015's existing
+ * `canMergeWith` clause: a `Delete` in the pending transaction followed by
+ * a `Create` of the same tag in the incoming one must refuse the merge.
+ * Passes today and must keep passing.
+ */
+TEST_F(MountingTransactionMergeOrderTest, RefusesMergeOnDeleteCreatePairing) {
+  auto pending = makeTransaction(
+      1, {ShadowViewMutation::DeleteMutation(viewWithTag(1))});
+  auto incoming = makeTransaction(
+      2, {ShadowViewMutation::CreateMutation(viewWithTag(1))});
+
+  EXPECT_FALSE(pending.canMergeWith(incoming));
+}
+
+/*
+ * Case 2 — DISABLED: documents a known, unclaimed gap in `canMergeWith`.
+ * It only checks `Delete` (pending) against `Create` (incoming); a
+ * `Delete` (pending) against `Insert` of the same tag (incoming) is not
+ * guarded and is allowed to merge. This is a real gap, but extending
+ * `canMergeWith` was never part of the accepted proposal for this issue —
+ * it's out of scope for this patch. Kept `DISABLED_` (gtest's standard
+ * documented-red-test convention) rather than deleted, so the gap stays
+ * provable and isn't silently reintroduced as a passing assertion.
+ */
+TEST_F(
+    MountingTransactionMergeOrderTest,
+    DISABLED_CanMergeWithRefusesDeleteInsertPairing) {
+  auto pending = makeTransaction(
+      1, {ShadowViewMutation::DeleteMutation(viewWithTag(1))});
+  auto incoming = makeTransaction(
+      2,
+      {ShadowViewMutation::InsertMutation(
+          /* parentTag */ 0, viewWithTag(1), /* index */ 0)});
+
+  EXPECT_FALSE(pending.canMergeWith(incoming));
+}
+
+/*
+ * Case 3 — execution-order invariant. With two pending transactions T1, T2
+ * for the same surface (T1 older, T2 newer — `canMergeWith`-refused, so
+ * both are queued rather than merged), an incoming T3 must merge into T2,
+ * not T1. Before the fix (forward `find_if`), T3 would merge into T1,
+ * producing `[T1+T3, T2]` and executing T3 before T2 even though T3 was
+ * diffed against a tree that already includes T2. Fails against the
+ * pre-fix `begin()/end()` lookup; passes with `rbegin()/rend()`.
+ */
+TEST_F(MountingTransactionMergeOrderTest, MergesIntoNewestPendingTransaction) {
+  std::vector<MountingTransaction> pendingTransactions;
+  pendingTransactions.push_back(
+      makeTransaction(1, {ShadowViewMutation::CreateMutation(viewWithTag(1))}));
+  pendingTransactions.push_back(
+      makeTransaction(2, {ShadowViewMutation::CreateMutation(viewWithTag(2))}));
+
+  // Mirrors the merge-target lookup in
+  // `FabricUIManagerBinding::schedulerDidFinishTransaction` post-fix: scans
+  // `pendingTransactions_` from the back so ties resolve to the newest entry.
+  auto incoming =
+      makeTransaction(3, {ShadowViewMutation::CreateMutation(viewWithTag(3))});
+  auto pendingTransaction = std::find_if(
+      pendingTransactions.rbegin(),
+      pendingTransactions.rend(),
+      [&](const auto& transaction) {
+        return transaction.getSurfaceId() == incoming.getSurfaceId();
+      });
+  if (pendingTransaction != pendingTransactions.rend() &&
+      pendingTransaction->canMergeWith(incoming)) {
+    pendingTransaction->mergeWith(std::move(incoming));
+  } else {
+    pendingTransactions.push_back(std::move(incoming));
+  }
+
+  ASSERT_EQ(pendingTransactions.size(), 2u);
+
+  // T1 (tag 1) must be untouched; T2 (tag 2) must have absorbed T3 (tag 3).
+  EXPECT_EQ(pendingTransactions[0].getMutations().size(), 1u);
+  EXPECT_EQ(pendingTransactions[0].getNumber(), MountingTransaction::Number{1});
+
+  ASSERT_EQ(pendingTransactions[1].getMutations().size(), 2u);
+  EXPECT_EQ(pendingTransactions[1].getNumber(), MountingTransaction::Number{3});
+  EXPECT_EQ(pendingTransactions[1].getMutations()[0].newChildShadowView.tag, 2);
+  EXPECT_EQ(pendingTransactions[1].getMutations()[1].newChildShadowView.tag, 3);
+}
