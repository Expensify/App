+void TextInputEventEmitter::onPaste(const std::vector<PastedFile>& files) const {
+  dispatchEvent("paste", [files](jsi::Runtime& runtime) {
+    auto filesArray = jsi::Array(runtime, files.size());
+    for (size_t i = 0; i < files.size(); i++) {
+      auto file = jsi::Object(runtime);
+      file.setProperty(runtime, "uri", files[i].uri);
+      file.setProperty(runtime, "type", files[i].type);
+      file.setProperty(runtime, "name", files[i].name);
+      file.setProperty(runtime, "size", files[i].size);
+      filesArray.setValueAtIndex(runtime, i, file);
+    }
+    auto payload = jsi::Object(runtime);
+    payload.setProperty(runtime, "files", filesArray);
+    return payload;
+  });
+}
