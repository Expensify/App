+/**
+ * Whether the pasteboard holds an item that should be pasted as a file instead of as text.
+ * Only reads the item types, never their data.
+ */
+RCT_EXTERN BOOL RCTPasteboardHasFiles(UIPasteboard *pasteboard);
+
+/**
+ * Copies the file items on the pasteboard into temporary files and calls `completion` on the main queue with one
+ * dictionary per file: `uri`, `type` (MIME type), `name` and `size`. Keeps the file name when the source app
+ * provides one. Returns NO without reading anything when the pasteboard holds no file items.
+ */
+RCT_EXTERN BOOL RCTPasteboardReadFiles(
+    UIPasteboard *pasteboard,
+    void (^completion)(NSArray<NSDictionary<NSString *, id> *> *files));
+
+NS_ASSUME_NONNULL_END
diff --git a/node_modules/react-native/Libraries/Text/TextInput/RCTPasteboardFiles.mm b/node_modules/react-native/Libraries/Text/TextInput/RCTPasteboardFiles.mm
