--- /dev/null
+++ b/node_modules/react-native/Libraries/Text/TextInput/RCTPasteboardFiles.mm
@@ -0,0 +1,285 @@
+/*
+ * Copyright (c) Meta Platforms, Inc. and affiliates.
+ *
+ * This source code is licensed under the MIT license found in the
+ * LICENSE file in the root directory of this source tree.
+ */
+
+#import "RCTPasteboardFiles.h"
+
+#import <UniformTypeIdentifiers/UniformTypeIdentifiers.h>
+
+// The Files app marks copied files with a private type with this prefix, next to the file's own type.
+static NSString *const RCTFilesAppItemTypePrefix = @"com.apple.DocumentManager.";
+
+static BOOL RCTIsFileMarkerType(NSString *identifier)
+{
+  return [identifier isEqualToString:UTTypeFileURL.identifier] || [identifier hasPrefix:RCTFilesAppItemTypePrefix];
+}
+
+static BOOL RCTIsGenericType(NSString *identifier)
+{
+  return [identifier isEqualToString:UTTypeData.identifier] || [identifier isEqualToString:UTTypeItem.identifier] ||
+      [identifier isEqualToString:UTTypeContent.identifier];
+}
+
+static BOOL RCTIsTextType(UTType *type)
+{
+  return [type conformsToType:UTTypeText] || [type conformsToType:UTTypeURL] || [type conformsToType:UTTypeRTFD] ||
+      [type conformsToType:UTTypeFlatRTFD] || [type conformsToType:UTTypeWebArchive];
+}
+
+static BOOL RCTHasFileMarkerType(NSArray<NSString *> *identifiers)
+{
+  for (NSString *identifier in identifiers) {
+    if (RCTIsFileMarkerType(identifier)) {
+      return YES;
+    }
+  }
+  return NO;
+}
+
+static BOOL RCTIsFileItem(NSItemProvider *itemProvider)
+{
+  // Apps that copy files, like Files, offer them for opening in place.
+  return RCTHasFileMarkerType(itemProvider.registeredTypeIdentifiers) ||
+      [itemProvider registeredTypeIdentifiersWithFileOptions:NSItemProviderFileOptionOpenInPlace].count > 0;
+}
+
+/**
+ * The representation to read as a file, or nil when UIKit should paste the item as text.
+ * Pasteboard items list their types from highest to lowest fidelity.
+ */
+static NSString *_Nullable RCTFileTypeIdentifier(NSArray<NSString *> *identifiers, BOOL isFile)
+{
+  if (isFile) {
+    // A copied file. Read its own type, which is a text type for files like .txt or .csv.
+    NSString *genericIdentifier = nil;
+    for (NSString *identifier in identifiers) {
+      if (RCTIsFileMarkerType(identifier)) {
+        continue;
+      }
+      if (!RCTIsGenericType(identifier)) {
+        return identifier;
+      }
+      genericIdentifier = genericIdentifier ?: identifier;
+    }
+    return genericIdentifier;
+  }
+
+  BOOL hasText = NO;
+  for (NSString *identifier in identifiers) {
+    UTType *type = [UTType typeWithIdentifier:identifier];
+    hasText = hasText || (type != nil && RCTIsTextType(type));
+  }
+
+  for (NSString *identifier in identifiers) {
+    UTType *type = [UTType typeWithIdentifier:identifier];
+    // Private app data, such as archived images or rich text, has no MIME type.
+    if (type.preferredMIMEType == nil || RCTIsGenericType(identifier)) {
+      continue;
+    }
+    // Text with extra representations, such as copied spreadsheet cells, stays text.
+    // An image copied together with its URL, as Safari does, is still an image.
+    if (RCTIsTextType(type) || (hasText && ![type conformsToType:UTTypeImage])) {
+      return nil;
+    }
+    return identifier;
+  }
+  return nil;
+}
+
+static NSString *RCTFileBaseName(UTType *_Nullable type)
+{
+  if ([type conformsToType:UTTypeImage]) {
+    return @"image";
+  }
+  if ([type conformsToType:UTTypeMovie]) {
+    return @"video";
+  }
+  if ([type conformsToType:UTTypeAudio]) {
+    return @"audio";
+  }
+  return @"file";
+}
+
+/**
+ * Makes sure the file name ends with an extension that matches the data, so the receiver can tell what the file is.
+ */
+static NSString *_Nullable RCTFileName(NSString *_Nullable name, UTType *_Nullable type)
+{
+  NSString *fileName = [name.lastPathComponent stringByReplacingOccurrencesOfString:@":" withString:@"_"];
+  NSString *extension = type.preferredFilenameExtension;
+  if (fileName.length == 0) {
+    return extension ? [RCTFileBaseName(type) stringByAppendingPathExtension:extension] : nil;
+  }
+
+  NSString *nameExtension = fileName.pathExtension;
+  if (!extension || [nameExtension caseInsensitiveCompare:extension] == NSOrderedSame) {
+    return fileName;
+  }
+
+  UTType *nameType = nameExtension.length > 0 ? [UTType typeWithFilenameExtension:nameExtension] : nil;
+  if (nameType == nil || nameType.isDynamic) {
+    return [fileName stringByAppendingPathExtension:extension];
+  }
+  if ([nameType conformsToType:type] || [type conformsToType:nameType]) {
+    return fileName;
+  }
+  // The data doesn't match the name, as when the source hands over a JPEG for a HEIC photo.
+  return [fileName.stringByDeletingPathExtension stringByAppendingPathExtension:extension];
+}
+
+static NSDictionary<NSString *, id> *_Nullable RCTWriteFile(
+    NSString *_Nullable sourceName,
+    UTType *_Nullable type,
+    BOOL (^write)(NSURL *destination))
+{
+  NSString *name = RCTFileName(sourceName, type);
+  NSString *mimeType = type.preferredMIMEType;
+  if (mimeType == nil && name.pathExtension.length > 0) {
+    mimeType = [UTType typeWithFilenameExtension:name.pathExtension].preferredMIMEType;
+  }
+  if (name.pathExtension.length == 0 && mimeType == nil) {
+    // Neither the type nor the name says what these bytes are, so leave them out.
+    return nil;
+  }
+
+  // Each file gets its own directory, so files keep their names without clashing.
+  NSURL *directory = [[NSURL fileURLWithPath:NSTemporaryDirectory() isDirectory:YES]
+      URLByAppendingPathComponent:[@"ReactNative/PastedFiles" stringByAppendingPathComponent:NSUUID.UUID.UUIDString]
+                      isDirectory:YES];
+  NSURL *destination = [directory URLByAppendingPathComponent:name isDirectory:NO];
+  if (![NSFileManager.defaultManager createDirectoryAtURL:directory
+                              withIntermediateDirectories:YES
+                                               attributes:nil
+                                                    error:nil] ||
+      !write(destination)) {
+    return nil;
+  }
+
+  NSNumber *size = [destination resourceValuesForKeys:@[ NSURLFileSizeKey ] error:nil][NSURLFileSizeKey];
+  return @{
+    @"uri" : destination.absoluteString,
+    @"type" : mimeType ?: @"application/octet-stream",
+    @"name" : name,
+    @"size" : size ?: @0,
+  };
+}
+
+/**
+ * Reads image data before `paste:` returns. Callers that put an image on the pasteboard and restore the previous
+ * content right after, like Genmoji support in react-native-live-markdown, depend on that.
+ */
+static NSDictionary<NSString *, id> *_Nullable RCTReadImage(
+    UIPasteboard *pasteboard,
+    NSUInteger index,
+    NSString *typeIdentifier,
+    NSString *_Nullable suggestedName)
+{
+  NSData *data =
+      [pasteboard dataForPasteboardType:typeIdentifier inItemSet:[NSIndexSet indexSetWithIndex:index]].firstObject;
+  if (!data) {
+    return nil;
+  }
+  return RCTWriteFile(suggestedName, [UTType typeWithIdentifier:typeIdentifier], ^BOOL(NSURL *destination) {
+    return [data writeToURL:destination atomically:YES];
+  });
+}
+
+/**
+ * Loads a file off the main thread, so large files don't block the UI.
+ */
+static void RCTLoadFile(
+    NSItemProvider *itemProvider,
+    NSString *typeIdentifier,
+    void (^completion)(NSDictionary<NSString *, id> *_Nullable file))
+{
+  UTType *type = [UTType typeWithIdentifier:typeIdentifier];
+  NSString *suggestedName = itemProvider.suggestedName;
+  [itemProvider loadFileRepresentationForTypeIdentifier:typeIdentifier
+                                      completionHandler:^(NSURL *_Nullable url, NSError *_Nullable error) {
+                                        if (!url) {
+                                          completion(nil);
+                                          return;
+                                        }
+                                        // The system deletes `url` when this block returns, so copy it first.
+                                        completion(RCTWriteFile(
+                                            suggestedName ?: url.lastPathComponent, type, ^BOOL(NSURL *destination) {
+                                              return [NSFileManager.defaultManager copyItemAtURL:url
+                                                                                           toURL:destination
+                                                                                           error:nil];
+                                            }));
+                                      }];
+}
+
+BOOL RCTPasteboardHasFiles(UIPasteboard *pasteboard)
+{
+  NSIndexSet *items = [NSIndexSet indexSetWithIndexesInRange:NSMakeRange(0, pasteboard.numberOfItems)];
+  for (NSArray<NSString *> *identifiers in [pasteboard pasteboardTypesForItemSet:items]) {
+    if (RCTFileTypeIdentifier(identifiers, RCTHasFileMarkerType(identifiers))) {
+      return YES;
+    }
+  }
+  return NO;
+}
+
+BOOL RCTPasteboardReadFiles(
+    UIPasteboard *pasteboard,
+    void (^completion)(NSArray<NSDictionary<NSString *, id> *> *files))
+{
+  NSArray<NSItemProvider *> *itemProviders = pasteboard.itemProviders;
+  NSMutableArray<NSNumber *> *indexes = [NSMutableArray new];
+  NSMutableArray<NSString *> *typeIdentifiers = [NSMutableArray new];
+  for (NSUInteger index = 0; index < itemProviders.count; index++) {
+    NSString *typeIdentifier =
+        RCTFileTypeIdentifier(itemProviders[index].registeredTypeIdentifiers, RCTIsFileItem(itemProviders[index]));
+    if (typeIdentifier) {
+      [indexes addObject:@(index)];
+      [typeIdentifiers addObject:typeIdentifier];
+    }
+  }
+  if (indexes.count == 0) {
+    return NO;
+  }
+
+  // One slot per file keeps the pasteboard order, whichever file finishes loading first.
+  NSMutableArray *files = [NSMutableArray arrayWithCapacity:indexes.count];
+  for (NSUInteger position = 0; position < indexes.count; position++) {
+    [files addObject:NSNull.null];
+  }
+  void (^store)(NSUInteger, NSDictionary *) = ^(NSUInteger position, NSDictionary *_Nullable file) {
+    @synchronized(files) {
+      files[position] = file ?: NSNull.null;
+    }
+  };
+
+  dispatch_group_t group = dispatch_group_create();
+  for (NSUInteger position = 0; position < indexes.count; position++) {
+    NSUInteger index = indexes[position].unsignedIntegerValue;
+    NSItemProvider *itemProvider = itemProviders[index];
+    NSString *typeIdentifier = typeIdentifiers[position];
+    if (!RCTIsFileItem(itemProvider) &&
+        [[UTType typeWithIdentifier:typeIdentifier] conformsToType:UTTypeImage]) {
+      store(position, RCTReadImage(pasteboard, index, typeIdentifier, itemProvider.suggestedName));
+      continue;
+    }
+
+    dispatch_group_enter(group);
+    RCTLoadFile(itemProvider, typeIdentifier, ^(NSDictionary<NSString *, id> *_Nullable file) {
+      store(position, file);
+      dispatch_group_leave(group);
+    });
+  }
+
+  dispatch_group_notify(group, dispatch_get_main_queue(), ^{
+    NSMutableArray<NSDictionary<NSString *, id> *> *pastedFiles = [NSMutableArray new];
+    for (id file in files) {
+      if (file != NSNull.null) {
+        [pastedFiles addObject:file];
+      }
+    }
+    completion(pastedFiles);
+  });
+  return YES;
+}
