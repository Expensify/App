+
+package com.facebook.react.views.textinput
+
+import android.content.ContentResolver
+import android.content.Context
+import android.net.Uri
+import android.provider.OpenableColumns
+import android.view.View
+import android.webkit.MimeTypeMap
+import androidx.core.view.ContentInfoCompat
+import androidx.core.view.OnReceiveContentListener
+import com.facebook.react.bridge.Arguments
+import com.facebook.react.bridge.WritableMap
+import com.facebook.react.uimanager.UIManagerHelper
+import com.facebook.react.uimanager.events.Event
+import java.io.File
+import java.util.Locale
+import java.util.UUID
+import java.util.concurrent.Executors
+
+/**
+ * Sends pasted files to JS as `onPaste` events and leaves text to the default paste handling. Receives content
+ * pasted from the clipboard and content that keyboards insert, such as images from Gboard's clipboard.
+ */
+internal class ReactTextInputPasteListener : OnReceiveContentListener {
+
+  override fun onReceiveContent(view: View, payload: ContentInfoCompat): ContentInfoCompat? {
+    val editText = view as? ReactEditText ?: return payload
+    if (payload.source != ContentInfoCompat.SOURCE_CLIPBOARD &&
+        payload.source != ContentInfoCompat.SOURCE_INPUT_METHOD) {
+      return payload
+    }
+
+    // Items with text are pasted as text. Apps like Google Docs put a content URI next to the copied text.
+    val split = payload.partition { item ->
+      item.text == null && item.uri?.scheme == ContentResolver.SCHEME_CONTENT
+    }
+    val fileContent = split.first ?: return payload
+    val context = editText.context.applicationContext
+
+    // The task holds on to `fileContent` until the files are copied, which keeps a keyboard's read access alive.
+    executor.execute {
+      val clip = fileContent.clip
+      val files = (0 until clip.itemCount).mapNotNull { index -> clip.getItemAt(index).uri?.let { copyFile(context, it) } }
+      if (files.isNotEmpty()) {
+        editText.post { dispatchPasteEvent(editText, files) }
+      }
+    }
+    return split.second
+  }
+
+  private data class PastedFile(val uri: String, val type: String, val name: String, val size: Long)
+
+  private class ReactTextInputPasteEvent(
+      surfaceId: Int,
+      viewId: Int,
+      private val files: List<PastedFile>,
+  ) : Event<ReactTextInputPasteEvent>(surfaceId, viewId) {
+
+    override fun getEventName(): String = EVENT_NAME
+
+    override fun canCoalesce(): Boolean = false
+
+    override fun getEventData(): WritableMap {
+      val filesArray = Arguments.createArray()
+      for (file in files) {
+        val fileMap = Arguments.createMap()
+        fileMap.putString("uri", file.uri)
+        fileMap.putString("type", file.type)
+        fileMap.putString("name", file.name)
+        fileMap.putDouble("size", file.size.toDouble())
+        filesArray.pushMap(fileMap)
+      }
+      val eventData = Arguments.createMap()
+      eventData.putArray("files", filesArray)
+      return eventData
+    }
+  }
+
+  internal companion object {
+    const val EVENT_NAME: String = "topPaste"
+
+    /** Content types announced to keyboards, so they offer to insert images and files. */
+    val MIME_TYPES: Array<String> = arrayOf("image/*", "video/*", "audio/*", "application/*")
+
+    private const val GENERIC_MIME_TYPE = "application/octet-stream"
+
+    // A single thread copies files in the order they were pasted.
+    private val executor = Executors.newSingleThreadExecutor()
+
+    private fun dispatchPasteEvent(editText: ReactEditText, files: List<PastedFile>) {
+      val reactContext = UIManagerHelper.getReactContext(editText)
+      UIManagerHelper.getEventDispatcherForReactTag(reactContext, editText.id)
+          ?.dispatchEvent(ReactTextInputPasteEvent(UIManagerHelper.getSurfaceId(editText), editText.id, files))
+    }
+
+    /**
+     * Copies the file into the cache directory, so it stays readable after the clipboard changes or the keyboard
+     * revokes access. Returns null when neither a type nor a file name says what the content is.
+     */
+    private fun copyFile(context: Context, uri: Uri): PastedFile? =
+        runCatching {
+              val resolver = context.contentResolver
+              val displayName = queryDisplayName(resolver, uri)
+              val nameExtension = displayName?.substringAfterLast('.', "")?.lowercase(Locale.ROOT).orEmpty()
+              val type =
+                  resolver.getType(uri)?.takeUnless { it == GENERIC_MIME_TYPE }
+                      ?: MimeTypeMap.getSingleton().getMimeTypeFromExtension(nameExtension)
+              val name = fileName(displayName, type) ?: return@runCatching null
+
+              val file = File(context.cacheDir, "PastedFiles/${UUID.randomUUID()}/$name")
+              file.parentFile?.mkdirs()
+              val input = resolver.openInputStream(uri) ?: return@runCatching null
+              input.use { file.outputStream().use { output -> it.copyTo(output) } }
+              PastedFile(Uri.fromFile(file).toString(), type ?: GENERIC_MIME_TYPE, name, file.length())
+            }
+            .getOrNull()
+
+    private fun queryDisplayName(resolver: ContentResolver, uri: Uri): String? =
+        runCatching {
+              resolver.query(uri, arrayOf(OpenableColumns.DISPLAY_NAME), null, null, null)?.use { cursor ->
+                if (cursor.moveToFirst()) cursor.getString(0) else null
+              }
+            }
+            .getOrNull()
+
+    /** Makes sure the file name has an extension, so the receiver can tell what the file is. */
+    private fun fileName(displayName: String?, type: String?): String? {
+      val name = displayName?.substringAfterLast('/')?.takeIf { it.isNotBlank() }
+      val extension = type?.let { MimeTypeMap.getSingleton().getExtensionFromMimeType(it) }
+      return when {
+        name == null -> extension?.let { "${baseName(type)}.$it" }
+        name.substringAfterLast('.', "").isNotEmpty() -> name
+        extension != null -> "$name.$extension"
+        type != null -> name
+        else -> null
+      }
+    }
+
+    private fun baseName(type: String?): String =
+        when (type?.substringBefore('/')) {
+          "image" -> "image"
+          "video" -> "video"
+          "audio" -> "audio"
+          else -> "file"
+        }
+  }
+}
