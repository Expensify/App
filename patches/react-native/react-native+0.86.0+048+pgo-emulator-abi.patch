diff --git a/node_modules/react-native/ReactAndroid/hermes-engine/pgo.cmake b/node_modules/react-native/ReactAndroid/hermes-engine/pgo.cmake
--- a/node_modules/react-native/ReactAndroid/hermes-engine/pgo.cmake
+++ b/node_modules/react-native/ReactAndroid/hermes-engine/pgo.cmake
@@ -4,7 +4,14 @@
     OUTPUT_VARIABLE CLANG_RESOURCE_DIR
     OUTPUT_STRIP_TRAILING_WHITESPACE
   )
-  set(PGO_RUNTIME "${CLANG_RESOURCE_DIR}/lib/linux/libclang_rt.profile-aarch64-android.a")
+  if(ANDROID_ABI STREQUAL "arm64-v8a")
+    set(PGO_ARCH aarch64)
+  elseif(ANDROID_ABI STREQUAL "x86_64")
+    set(PGO_ARCH x86_64)
+  else()
+    message(FATAL_ERROR "Unsupported PGO ABI: ${ANDROID_ABI}")
+  endif()
+  set(PGO_RUNTIME "${CLANG_RESOURCE_DIR}/lib/linux/libclang_rt.profile-${PGO_ARCH}-android.a")
   if(NOT EXISTS "${PGO_RUNTIME}")
     message(FATAL_ERROR "LLVM profiling runtime was not found at ${PGO_RUNTIME}")
   endif()
