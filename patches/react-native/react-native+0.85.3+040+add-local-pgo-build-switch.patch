diff --git a/node_modules/react-native/ReactAndroid/src/main/jni/CMakeLists.txt b/node_modules/react-native/ReactAndroid/src/main/jni/CMakeLists.txt
--- a/node_modules/react-native/ReactAndroid/src/main/jni/CMakeLists.txt
+++ b/node_modules/react-native/ReactAndroid/src/main/jni/CMakeLists.txt
@@ -8,6 +8,14 @@ set(CMAKE_VERBOSE_MAKEFILE on)
 
 project(ReactAndroid)
+
+if(PGO_MODE STREQUAL "generate")
+  execute_process(
+    COMMAND ${CMAKE_CXX_COMPILER} --print-resource-dir
+    OUTPUT_VARIABLE CLANG_RESOURCE_DIR
+    OUTPUT_STRIP_TRAILING_WHITESPACE
+  )
+  set(PGO_RUNTIME "${CLANG_RESOURCE_DIR}/lib/linux/libclang_rt.profile-aarch64-android.a")
+  if(NOT EXISTS "${PGO_RUNTIME}")
+    message(FATAL_ERROR "LLVM profiling runtime was not found at ${PGO_RUNTIME}")
+  endif()
+  add_compile_options(-fprofile-generate)
+  add_link_options(
+    -fprofile-generate
+    "-Wl,--whole-archive,${PGO_RUNTIME},--no-whole-archive"
+    -Wl,--export-dynamic-symbol=__llvm_profile_set_filename
+    -Wl,--export-dynamic-symbol=__llvm_profile_write_file
+  )
+elseif(PGO_MODE STREQUAL "use")
+  add_compile_options("-fprofile-use=${PGO_PROFILE}")
+  add_link_options("-fprofile-use=${PGO_PROFILE}")
+endif()
 
 include(CheckIPOSupported)
 check_ipo_supported(RESULT IPO_SUPPORT)
