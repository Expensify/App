diff --git a/node_modules/react-native/ReactAndroid/hermes-engine/pgo.cmake b/node_modules/react-native/ReactAndroid/hermes-engine/pgo.cmake
new file mode 100644
index 0000000..bcc335d
--- /dev/null
+++ b/node_modules/react-native/ReactAndroid/hermes-engine/pgo.cmake
@@ -0,0 +1,25 @@
+if(PGO_MODE STREQUAL "generate")
+  execute_process(
+    COMMAND ${CMAKE_CXX_COMPILER} --print-resource-dir
+    OUTPUT_VARIABLE CLANG_RESOURCE_DIR
+    OUTPUT_STRIP_TRAILING_WHITESPACE
+  )
+  set(PGO_RUNTIME "${CLANG_RESOURCE_DIR}/lib/linux/libclang_rt.profile-aarch64-android.a")
+  if(NOT EXISTS "${PGO_RUNTIME}")
+    message(FATAL_ERROR "LLVM profiling runtime was not found at ${PGO_RUNTIME}")
+  endif()
+  add_compile_options(-fprofile-generate)
+  add_link_options(
+    -fprofile-generate
+    "-Wl,--whole-archive,${PGO_RUNTIME},--no-whole-archive"
+    -Wl,--undefined=__llvm_profile_set_filename
+    -Wl,--undefined=__llvm_profile_write_file
+    -Wl,--defsym=expensify_llvm_profile_set_filename=__llvm_profile_set_filename
+    -Wl,--defsym=expensify_llvm_profile_write_file=__llvm_profile_write_file
+    -Wl,--export-dynamic-symbol=expensify_llvm_profile_set_filename
+    -Wl,--export-dynamic-symbol=expensify_llvm_profile_write_file
+  )
+elseif(PGO_MODE STREQUAL "use")
+  add_compile_options("-fprofile-use=${PGO_PROFILE}")
+  add_link_options("-fprofile-use=${PGO_PROFILE}")
+endif()
