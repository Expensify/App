     shareController.view.tintColor = [RCTConvert UIColor:options[@"tintColor"]];
 }
 
 
+RCT_EXPORT_METHOD(dismiss:(RCTPromiseResolveBlock)resolve
+                  reject:(RCTPromiseRejectBlock)reject)
+{
+    dispatch_block_t dismissShareController = ^{
+        UIActivityViewController *shareController = currentShareController;
+        if (!shareController || !shareController.presentingViewController) {
+            resolve(nil);
+            return;
+        }
+        [shareController.presentingViewController dismissViewControllerAnimated:YES completion:^{
+            // UIKit doesn't call the completion handler for a programmatic dismiss, so run it ourselves to settle the pending `open` promise as cancelled
+            UIActivityViewControllerCompletionWithItemsHandler completionHandler = shareController.completionWithItemsHandler;
+            if (completionHandler) {
+                completionHandler(nil, NO, nil, nil);
+            }
+            resolve(nil);
+        }];
+    };
+
+    if (isShareControllerPresenting) {
+        if (!dismissesWaitingForPresentation) {
+            dismissesWaitingForPresentation = [NSMutableArray array];
+        }
+        [dismissesWaitingForPresentation addObject:[dismissShareController copy]];
+        return;
+    }
+    dismissShareController();
+}
