+// The share sheet presented by `open`, kept so that `dismiss` can close it.
+static __weak UIActivityViewController *currentShareController;
+// Right after `open`, UIKit still reports no presenting view controller for the sheet (the presentation only starts a moment later), so a
+// `dismiss` arriving in that window would find nothing to close. Such calls are queued here and run once the presentation completes.
+static BOOL isShareControllerPresenting = NO;
+static NSMutableArray<dispatch_block_t> *dismissesWaitingForPresentation;
+
+// Called when the presentation completes, to run the `dismiss` calls that were waiting for it
+static void finishShareControllerPresentation(void) {
+    isShareControllerPresenting = NO;
+    NSArray<dispatch_block_t> *waitingDismisses = [dismissesWaitingForPresentation copy];
+    [dismissesWaitingForPresentation removeAllObjects];
+    for (dispatch_block_t dismiss in waitingDismisses) {
+        dismiss();
+    }
+}
