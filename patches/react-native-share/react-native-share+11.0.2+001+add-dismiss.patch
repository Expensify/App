+    // UIKit can't present a second sheet on top of a first one, and `dismiss` only tracks one, so treat the extra request as cancelled
+    UIActivityViewController *openShareController = currentShareController;
+    if (openShareController && (isShareControllerPresenting || openShareController.presentingViewController)) {
