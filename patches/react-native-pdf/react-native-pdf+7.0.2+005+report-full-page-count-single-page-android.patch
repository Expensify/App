+    private int getDocumentPageCount(int fallbackPageCount) {
+        ParcelFileDescriptor fileDescriptor = null;
+        PdfRenderer renderer = null;
+        try {
+            if (this.path.startsWith("content://")) {
+                fileDescriptor = getContext().getContentResolver().openFileDescriptor(Uri.parse(this.path), "r");
+            } else {
+                fileDescriptor = ParcelFileDescriptor.open(new File(getURI(this.path).getPath()), ParcelFileDescriptor.MODE_READ_ONLY);
+            }
+            if (fileDescriptor == null) {
+                return fallbackPageCount;
+            }
+            renderer = new PdfRenderer(fileDescriptor);
+            return renderer.getPageCount();
+        } catch (Exception e) {
+            // PdfRenderer can't open password-protected files, so keep the loaded page count.
+            Log.e("PdfView", "error while reading PDF page count", e);
+            return fallbackPageCount;
+        } finally {
+            if (renderer != null) {
+                renderer.close();
+            }
+            if (fileDescriptor != null) {
+                try {
+                    fileDescriptor.close();
+                } catch (IOException e) {
+                    Log.e("PdfView", "error while closing PDF", e);
+                }
+            }
+        }
+    }
