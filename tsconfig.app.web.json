{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "tsBuildInfoFile": "./tsconfig.app.web.ts7.tsbuildinfo",
        // "react-native" here loads `@types/react-native@0.72` (a hanging
        // transitive package), which is what the previous mega-program used
        // and is required for several third-party type gaps. RN's own types
        // still come in via imports of `react-native`.
        "types": ["react-native", "react-native-web"],
        "lib": ["DOM", "ESNext"],
        "moduleSuffixes": [".web", ""]
    },
    "include": [
        "src",
        "assets",
        "prompts",
        ".storybook/**/*",
        "types/env.d.ts",
        // Not app directories, but the web program reaches into them: `src/App.tsx` imports
        // `wdyr`, `src/libs/ApiUtils` imports `config/proxyConfig`, `.storybook` imports the
        // Rsbuild config, and the Storybook stories import the shared report fixtures. They were
        // already being type-checked here via those imports; listing them makes that visible.
        "wdyr.ts",
        "config/proxyConfig.ts",
        "config/rsbuild",
        "__mocks__/reportData"
    ],
    "exclude": [
        "**/node_modules/*",
        "**/dist/*",
        "src/types/native/**",
        "src/types/modules/jest.d.ts",
        "src/**/__mocks__/**",
        "src/**/*.native.ts",
        "src/**/*.native.tsx",
        "src/**/*.ios.ts",
        "src/**/*.ios.tsx",
        "src/**/*.android.ts",
        "src/**/*.android.tsx",
        "modules/ExpensifyNitroUtils/**"
    ]
}
