{
    // lint.ts uses Bun's `$` shell, which needs `@types/bun`. Those types redeclare globals the app's own
    // types already own (see tests/tooling/tsconfig.json for the same tradeoff), so this project confines
    // them to just the file that needs them. Everything else in scripts/ stays in the root project, where
    // it sees the app's real types.
    //
    // `include: []` is required: `extends` inherits the root project's `include`, which would otherwise
    // pull the whole app in here and reintroduce the same conflict this file exists to avoid.
    "extends": "../tsconfig.json",
    "compilerOptions": {
        "types": ["@types/bun"],
        "noEmit": true
    },
    "include": [],
    "files": ["lint.ts"]
}
